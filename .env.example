# Copy to .env.local and fill in. All are public (NEXT_PUBLIC_) — no secrets here.

# Formspree form id for the catering inquiry form (the part after /f/ in the
# endpoint URL). Without it the form validates but tells the user to email instead.
NEXT_PUBLIC_FORMSPREE_ID=

# Delivery storefronts. The client brief lists DoorDash and Grubhub but leaves
# the URLs blank; until these are set the modal shows a "coming soon" tile
# rather than a dead link.
NEXT_PUBLIC_DOORDASH_URL=
NEXT_PUBLIC_GRUBHUB_URL=
